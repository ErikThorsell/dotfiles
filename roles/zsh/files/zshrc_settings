# Check if mise is installed; if so, activate it
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Editor
export GIT_EDITOR="nvim"
export EDITOR="nvim"

# Extend PATH
export PATH="$HOME/.local/bin:$PATH"
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# Include pkg
path+=("$HOME/pkg")
path+=("$HOME/pkg/bin")
export PATH

# Include scripts
path+=("$HOME/scripts")
export PATH

# Check if terraform is installed; if so, install autocomplete
if command -v terraform >/dev/null 2>&1; then
  complete -C "$(command -v terraform)" terraform
fi

# Check if kubectl is installed; if so, install autocomplete
if command -v kubectl >/dev/null 2>&1; then
  source <(kubectl completion zsh)
  compdef k=kubectl
fi

# Source secret environment variables
if [ -f $HOME/.secretenv ]; then
  source $HOME/.secretenv
fi
