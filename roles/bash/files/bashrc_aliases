# Shell
# Colours for ls: GNU ls takes --color, BSD/macOS ls reads CLICOLOR
if ls --color=auto -d . >/dev/null 2>&1; then
  alias ls='ls --color=auto'
else
  export CLICOLOR=1
fi
alias ll='ls -l'
alias la='ls -la'

# Tools
alias k='kubectl'
alias jira='jira-cli'
alias tctl='talosctl'

# Docker
alias d_kill="docker ps -q | xargs docker kill"
alias d_rcon_all="docker ps -aq | xargs docker rm"
alias d_rmi="docker images -aq | xargs docker rmi"

# macOS
if [ "$(uname -s)" = "Darwin" ]; then
  alias restart-sound="sudo killall coreaudiod && echo Done"
fi

# ripgrep “filename search” function
rgf() {
  if [ $# -eq 0 ]; then
    rg --files
    return
  fi

  # Build one --iglob "**/*PAT*" per argument
  # --iglob: case-insensitive glob
  local iglobs=()
  for pat in "$@"; do
    iglobs+=(--iglob "**/*${pat}*")
  done

  # --files: list paths only
  rg --files "${iglobs[@]}"
}


# Redact any string‐valued field whose key contains “secret” (case‐insensitive)
yq_nosecrets() {
  yq eval-all '(.. 
      | select(tag == "!!str") 
      | select((path | .[-1]) | test("(?i)secret"))
    ) = "<REDACTED>"'
}

# Random ASCII letters+digits. Usage: random [LEN]; default LEN=21
random() {
  local n="${1:-21}"
  if ! [[ "$n" =~ ^[1-9][0-9]*$ ]]; then
    printf 'Usage: random [positive_length]\n' >&2
    return 2
  fi
  # Force C locale so tr ranges mean ASCII and avoid "Illegal byte sequence"
  LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c "$n"; echo
}

