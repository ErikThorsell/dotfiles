# THIS FILE IS MAINTAINED FROM THE dotfiles REPOSITORY!
# Make ALL changes in the repository and re-run the Ansible playbook to apply.
[alias]

# Commit oriented aliases
  amend = commit --amend
  discard = checkout --
  precommit = diff --cached --diff-algorithm=minimal -w
  save = commit -m
  saveall = commit -a
  uncommit = reset --mixed HEAD~
  unstage = reset -q HEAD --
  force = !git add . && git amend --no-edit && git push --force-with-lease && :

# Merge oriented aliases
  branches = branch -a
  solved = rebase --continue
  stashes = stash list
  tags = tag
  unmerged = diff --name-only --diff-filter=U
  # Collapse the branch into staged changes on top of its fork point, ready for one commit: git squash-branch [base=main]
  squash-branch = "!f() { git reset --soft $(git merge-base \"${1:-main}\" HEAD); }; f"


# Info/Status oriented aliases
  authors = shortlog -s -n
  blame-plus = "!f() { git ls-tree -r -z --name-only HEAD -- ${1:-.} | xargs -0 -n1 git blame --line-porcelain HEAD | grep '^author ' | sort | uniq -c | sort -nr; }; f"
  lines = "!f() { since=\"\"; [ -n \"$1\" ] && since=\"--since=$1\"; printf \"%8s %8s %8s  %s\\n\" \"Total\" \"Added\" \"Removed\" \"Author\" && git log $since --pretty=format:\"%an\" --numstat | awk -F'\\t' 'NF==1 {author=$0} NF==3 {added[author]+=$1; removed[author]+=$2} END {for (a in added) printf \"%8d %8d %8d  %s\\n\", added[a]+removed[a], added[a], removed[a], a}' | sort -rn; }; f"
  graph = log --graph -25 --branches --remotes --tags  --format=format:'%Cgreen%h %Creset %<(75,trunc)%s (%cN, %cr) %Cred%d' --date-order
  history = log -10 --format=format:'%Cgreen%h %Creset %s (%cN, %ar)'
  last = log -1 HEAD --format=format:"%Cred%H"
  remotes = remote -v
  list = "add --dry-run ."


# Review oriented aliases
#
# What each one compares, which is the easy thing to get wrong:
#   gr, grd  patch set vs its own parent -- "what does this change do?"
#   grr      patch set vs local HEAD    -- "what has changed since I amended?"
#   grw      patch set vs worktree     -- "what am I changing while reviewing?"
#   grc      nothing; it reads comments
# gr and grd differ only in how they render the same diff, not in what they show.
#
# gerrit.nvim: with no argument, a picker of open changes for this project; with
# a change number, straight into that change's diff, inline review comments and
# all.
  gr = "!f() { if [ -n \"$1\" ]; then nvim -c \"Gerrit diff $1\"; else nvim -c Gerrit; fi; }; f"
# The same comparison as gr, rendered through Diffview instead: a file tree on
# the left, one file at a time side-by-side (Neovim :GerritReview). Latest patch
# set. Give it the change number: git grd 663672
  grd = "!f() { nvim -c \"GerritReview $1\"; }; f"
# Read every inline review comment on a Gerrit change, across all patch sets
# (Neovim :GerritComments) -- gerrit.nvim only shows the current one. git grc 663672
  grc = "!f() { nvim -c \"GerritComments $1\"; }; f"
# Your local HEAD against the patch set already on Gerrit (Neovim :GerritAmend),
# i.e. what a reviewer re-reads after you amend. This is the one thing grd cannot
# show: `^!` always means "against my parent", so grd keeps rendering the pushed
# patch set even once your worktree has moved past it. Same Diffview tree as grd.
# Optional second argument pins an older patch set: git grr 663672 2
  grr = "!f() { nvim -c \"GerritAmend $1 $2\"; }; f"
# Compare the Gerrit patch set with the current working tree. The working-tree
# side is editable, so this is useful when making fixes while reviewing.
# Optional second argument pins an older patch set: git grw 663672 2
  grw = "!f() { nvim -c \"GerritWorktree $1 $2\"; }; f"

# Alias oriented aliases
  alias = config --get-regexp ^alias\\.

# Settings
[pull]
  rebase = true

[push]
  autoSetupRemote = true

[core]
  editor = nvim
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true

[difftool]
  prompt = false

[merge]
  tool = neovim

[mergetool]
  prompt = false

[mergetool "vimdiff"]
  cmd = vim -d $BASE $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[mergetool "neovim"]
  cmd = nvim -d $LOCAL $MERGED $REMOTE

[rerere]
  enabled = true

[init]
  defaultBranch = main
